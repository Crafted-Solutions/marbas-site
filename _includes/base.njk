{# @name: Seitenlayout (Basis) #}
{# @description: Globales HTML-Layout mit Header, Content und Footer. #}
{# @category: layout #}

<!DOCTYPE html>
<html lang="{{pageLanguage}}"{% if marbasTheme.palette %} data-palette="{{ marbasTheme.palette }}"{% endif %}>

{% set dlang = defaultLanguage %}

  <head>
    <base href="">
    {% siteMeta %}

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"><!-- 180×180 -->

    {% siteHeadAssets %}
  </head>

  <body class="c-page c-page--{{ marbasTheme.family or 'classic' }}">
    <div class="c-container">
      {% if buildConfig.useLanguageSwitcher and websiteLanguageCount > 1 %}
      {% set _alternates = collections.all | languageAlternates(page) %}
      <div class="c-language-switcher">
        <language-switcher default-language="{{dlang}}" languages='{{websiteLanguages}}' alternates='{{ _alternates | dump }}'></language-switcher>
      </div>
      {% endif %}

      {% siteHeader %}

      {# A page gets its <h1> from a Hero (or any block with providesH1: true); otherwise the page title becomes the <h1>. #}
      {% set hasHeroInPage = false %}
      {% for _placeholder in [Placeholder_Hero, Placeholder_Main, Placeholder_Aside_1, Placeholder_Aside_2] %}
        {% for item in (_placeholder or []) %}
          {% if item.componentType == "Hero" or item.providesH1 %}
            {% set hasHeroInPage = true %}
          {% endif %}
        {% endfor %}
      {% endfor %}
      <main id="main-content" class="c-main">
        <div class="c-container">
          {% set hasPageTitle = (title | default('') | trim) != '' %}
          {% if hasPageTitle and not hasHeroInPage %}
          <div class="c-section--top-only">
            <div class="c-component c-component--secondary">
              <h1 class="c-page-title">{{ title }}</h1>
            </div>
          </div>
          {% endif %}
          {{ content | safe }}
        </div>
      </main>

      {% siteFooter %}
    </div>

  </body>

</html>
