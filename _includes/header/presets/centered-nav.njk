{%- set _variant = site.header.variant | default("default") -%}
<a class="c-skip-link" href="#main-content">{{ "skipLink" | uiText(pageLanguage) }}</a>
{% include "header/slots/announcement.njk" %}
<header role="banner" class="c-header c-header--centered{% if _variant and _variant != 'default' %} c-header--{{ _variant }}{% endif %}{% if site.header.sticky %} c-header--sticky{% endif %}">
  <div class="c-container c-header__inner">
    <div class="c-header__top">
      {% include "header/slots/brand.njk" %}
    </div>
    <div class="c-header__bottom">
      {% include "header/slots/nav.njk" %}
    </div>
    {% include "header/slots/scheme-toggle.njk" %}<button class="c-nav-toggle" type="button" aria-label="{{ "navOpen" | uiText(pageLanguage) }}" aria-expanded="false" aria-controls="main-nav">
      <span class="c-nav-toggle__icon" aria-hidden="true"></span>
    </button>
  </div>
</header>
