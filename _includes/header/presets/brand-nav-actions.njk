{%- set _variant = site.header.variant | default("default") -%}
{#- mobile (< 768px): header.actions move from the header row into the menu panel (header.mobile.showActionsInDrawer, default on) #}
{%- set _navActions = site.header.actions and (site.header.actions | length) > 0 and site.header.mobile.showActionsInDrawer != false -%}
<a class="c-skip-link" href="#main-content">{{ "skipLink" | uiText(pageLanguage) }}</a>
{% include "header/slots/announcement.njk" %}
<header role="banner" class="c-header c-header--with-actions{% if _navActions %} c-header--actions-in-nav{% endif %}{% if _variant and _variant != 'default' %} c-header--{{ _variant }}{% endif %}{% if site.header.sticky %} c-header--sticky{% endif %}">
  <div class="c-container c-header__inner">
    {% include "header/slots/brand.njk" %}
    {% include "header/slots/nav.njk" %}
    {% include "header/slots/actions.njk" %}
    {% include "header/slots/scheme-toggle.njk" %}<button class="c-nav-toggle" type="button" aria-label="{{ "navOpen" | uiText(pageLanguage) }}" aria-expanded="false" aria-controls="main-nav">
      <span class="c-nav-toggle__icon" aria-hidden="true"></span>
    </button>
  </div>
</header>
