{%- if site.footer.socialLinks and (site.footer.socialLinks | length) > 0 -%}
<div class="c-footer-social">
  <ul class="c-footer-social__list">
    {%- for social in site.footer.socialLinks %}
    <li class="c-footer-social__item">
      <a class="c-footer-social__link c-footer-social__link--{{ social.platform }}"
         href="{{ social.href | t(pageLanguage) }}"
         aria-label="{{ (social.ariaLabel | t(pageLanguage)) or (social.label | t(pageLanguage)) }}"
         target="_blank"
         rel="noopener noreferrer">
        {{ social.platform | socialIcon | safe }}
        <span class="u-sr-only">{{ (social.ariaLabel | t(pageLanguage)) or (social.label | t(pageLanguage)) }}</span>
      </a>
    </li>
    {%- endfor %}
  </ul>
</div>
{%- endif -%}
