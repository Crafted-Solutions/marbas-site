{%- set _bottomLinks = site.footer.bottomLinks | default({}) -%}
<div class="c-footer-bottom">
  <div class="c-container c-footer-bottom__inner">
    {%- if site.footer.copyright %}
    <small class="c-footer-bottom__copyright">{{ site.footer.copyright | t(pageLanguage) }}</small>
    {%- endif %}
    {%- if _bottomLinks.source == "tagCollection" %}
    {%- set _bottomPages = [] %}
    {%- for tag in _bottomLinks.tags %}
      {%- set _tagPages = collections[tag] | default([]) | filterCollectionByLanguage(pageLanguage) %}
      {%- set _bottomPages = (_bottomPages.concat(_tagPages)) %}
    {%- endfor %}
    {%- if (_bottomPages | length) > 0 %}
    <nav class="c-footer-bottom__nav" aria-label="{{ "legal" | uiText(pageLanguage) }}">
      <ul class="c-footer-bottom__list">
        {%- for item in _bottomPages %}{% if loop.index <= (_bottomLinks.limit | default(10)) %}
        <li><a class="c-footer-bottom__link" href="{{ item.url }}">{{ item.data.title | default(item.fileSlug) }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </nav>
    {%- endif %}
    {%- elif _bottomLinks.links and (_bottomLinks.links | length) > 0 %}
    <nav class="c-footer-bottom__nav" aria-label="{{ "legal" | uiText(pageLanguage) }}">
      <ul class="c-footer-bottom__list">
        {%- for link in _bottomLinks.links %}
        <li>
          <a class="c-footer-bottom__link"
             href="{{ link.href | t(pageLanguage) }}"
             {%- if link.ariaLabel %} aria-label="{{ link.ariaLabel | t(pageLanguage) }}"{% endif %}
             {%- if link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label | t(pageLanguage) }}</a>
        </li>
        {%- endfor %}
      </ul>
    </nav>
    {%- endif %}
    {%- set _bottomNote = site.footer.bottomNote | t(pageLanguage) %}
    {%- if _bottomNote %}
    <p class="c-footer-bottom__note">{{ _bottomNote | safe }}</p>
    {%- endif %}
    {%- if marbasTheme.scheme == 'auto' and site.footer.schemeToggle != false %}
    <div class="c-scheme-switch" role="group" aria-label="{{ "scheme" | uiText(pageLanguage) }}">
      <span class="c-scheme-switch__label" aria-hidden="true">{{ "scheme" | uiText(pageLanguage) }}</span>
      <button type="button" class="c-scheme-switch__option" data-scheme-set="light" aria-pressed="false">{{ "schemeLight" | uiText(pageLanguage) }}</button>
      <button type="button" class="c-scheme-switch__option" data-scheme-set="dark" aria-pressed="false">{{ "schemeDark" | uiText(pageLanguage) }}</button>
      <button type="button" class="c-scheme-switch__option" data-scheme-set="auto" aria-pressed="true">{{ "schemeSystem" | uiText(pageLanguage) }}</button>
    </div>
    {%- endif %}
  </div>
</div>
